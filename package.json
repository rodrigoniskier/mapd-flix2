{
  "name": "mapd-flix",
  "version": "1.0.0",
  "private": true,
  "description": "MAPD-Flix — plataforma educacional de Imunologia Clínica em formato de séries (Mecanismos de Agressão, Patológicos e de Defesa).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --serve",
    "start": "node scripts/serve.mjs dist 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 tests/e2e/*.test.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
